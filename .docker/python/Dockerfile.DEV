FROM python:3.11-slim-bookworm@sha256:528257d48c1da0dcecc2e725d1ae34498d60c965f1241e39cd6a85a8859bdf84
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /var/www/html
COPY src/requirements.lock /tmp/dependencies/requirements.lock
RUN python -m pip install -r /tmp/dependencies/requirements.lock     && groupadd --gid 10001 dubber     && useradd --uid 10001 --gid dubber --create-home dubber
COPY --chown=dubber:dubber src/ /var/www/html/
RUN mkdir -p /var/lib/dubber/media && chown dubber:dubber /var/lib/dubber/media
USER dubber
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
